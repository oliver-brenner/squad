# Supabase — same project as gymtracker
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PowerSync — from your PowerSync Cloud dashboard
VITE_POWERSYNC_URL=

# Dev-only email/password login (DEV builds only) — lets you sign in without the
# Google OAuth redirect, which can't complete inside the Claude preview sandbox.
# Set a password for your own user in Supabase, then put your credentials here.
VITE_DEV_LOGIN_EMAIL=
VITE_DEV_LOGIN_PASSWORD=
